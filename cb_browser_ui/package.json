{
  "scripts": {
    "build-css": "lessc --js main.less dist/main.css",
    "build-js-bundle": "node buildJs.js",
    "build-html": "node buildHtml.js",
    "build-js": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && npm run build-css && npm run build-js-bundle && npm run build-html",
    "watch-js": "node buildJs.js --watch",
    "build-rust": "cargo-web build --release && node copyWasm.js",
    "build": "npm run build-rust && npm run build-js",
    "start": "npm run build-rust && npm run watch-js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "antd": "^3.19.2",
    "gl-matrix": "^2.6.1",
    "immutability-helper": "^2.7.1",
    "monet": "git+https://github.com/aeickhoff/monet.git#5b79f29034c239961f2c93310ddc78ed868865fe",
    "mousetrap": "^1.6.2",
    "msgpack-lite": "^0.1.26",
    "react": "^16.8.6",
    "react-addons-update": "^15.6.2",
    "react-container-dimensions": "^1.3.4",
    "react-dom": "^16.8.6",
    "stacktrace-js": "^2.0.0"
  },
  "devDependencies": {
    "@types/gl-matrix": "^2.4.5",
    "@types/react-dom": "^16.9.6",
    "@types/stacktrace-js": "^2.0.3",
    "esbuild": "^0.28.2",
    "less": "^3.8.1",
    "typescript": "^3.8.3"
  },
  "browser": {
    "fs": false
  }
}
